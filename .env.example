# Copy to .env.local for local development, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production.

# --- Site -------------------------------------------------------------------
# Public URL, used for social previews, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ganhometro.com.br
# Shown in the footer, privacy policy and terms (defaults to contato@ganhometro.com.br).
NEXT_PUBLIC_CONTACT_EMAIL=
# Data controller named in the privacy policy (person or company, optionally CPF/CNPJ).
NEXT_PUBLIC_CONTROLLER_NAME=

# Show the carnê-leão spreadsheet download after signup. Turn on only after the
# accountant review (README → Signup bonus).
NEXT_PUBLIC_BONUS_READY=false

# --- Admin page (/admin) ---------------------------------------------------
# Turns on the private waitlist dashboard. Use a long, unique password (12+ characters).
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin login cookie.
ADMIN_SESSION_SECRET=

# --- Brevo (waitlist) -------------------------------------------------------
# Brevo → SMTP & API → API keys. Server-only: never prefix with NEXT_PUBLIC_.
BREVO_API_KEY=
# Brevo → Contacts → Lists → the list's ID number.
BREVO_LIST_ID=
# Optional double opt-in (recommended). Set both to turn it on.
BREVO_DOI_TEMPLATE_ID=
# Optional: confirmation template for English signups (falls back to the one above).
BREVO_DOI_TEMPLATE_ID_EN=
BREVO_DOI_REDIRECT_URL=

# --- Supabase (the app, /app) -----------------------------------------------
# Local: `npx supabase start` prints both values (API URL and Publishable key).
# Production: Supabase → Project Settings → API. Leave empty to show
# "app not configured" on /app; the landing page doesn't need them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (never NEXT_PUBLIC_): writes the shared exchange-rate table. Local: the "Secret key" from
# `npx supabase start`. Production: Project Settings → API → secret key.
SUPABASE_SECRET_KEY=
# Protects /api/cron/daily (Vercel Cron sends it as a bearer token). Any long random string.
CRON_SECRET=

# --- App emails (reminders, alerts, weekly summary) --------------------------
# resend.com → API Keys. Without it, emails go to MAILPIT_URL (local) or are only logged.
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
EMAIL_FROM=Ganhômetro <nao-responda@ganhometro.com.br>
# Local only: the Supabase CLI's inbox, http://127.0.0.1:54324. Leave empty in production.
MAILPIT_URL=

# --- Umami (analytics) ------------------------------------------------------
# Website ID from cloud.umami.is. Leave empty to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: script URL for a self-hosted Umami (defaults to Umami Cloud).
NEXT_PUBLIC_UMAMI_SRC=

# --- Plans and checkout (Mercado Pago) -----------------------------------------
# Mercado Pago → Suas integrações → your application → Credenciais de produção (or de teste) → Access token.
# Server only. Without it, the plan page says payment isn't available yet.
MP_ACCESS_TOKEN=
# Mercado Pago → Suas integrações → Webhooks → "Assinatura secreta". Notifications go to
# https://<your domain>/api/mercadopago/webhook (events: Pagamentos, Planos e assinaturas).
MP_WEBHOOK_SECRET=
# The founding offer (R$ 99) is on sale until this day (inclusive), YYYY-MM-DD. Empty = not on sale.
FOUNDING_UNTIL=
# Launch day, YYYY-MM-DD: founding buyers' year of Pro starts here.
LAUNCH_DATE=
# Local tests only: a fake Mercado Pago server. Leave empty everywhere else.
MP_API_URL=
